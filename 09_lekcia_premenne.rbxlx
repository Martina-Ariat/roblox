		<Item class="Script" referent="RBX4">
			<Properties>
				<string name="Name">script_9.1</string>
				<ProtectedString name="Source"><![CDATA[local bydlisko = "Margecany"
local vek = 12

print("Moje bydlisko je: ", bydlisko)
print("Moj vek je: ", vek)]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX5">
			<Properties>
				<string name="Name">script_9.2</string>
				<ProtectedString name="Source"><![CDATA[local sport = "futbal"
local oblubeneJedlo = "burger"

print("Mam rad " .. sport .. " a moje oblubene jedlo je " .. oblubeneJedlo)]]></ProtectedString>
				<bool name="Disabled">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX6">
			<Properties>
				<string name="Name">script_9.3</string>
				<ProtectedString name="Source"><![CDATA[local peniaze = 100
print("Peniaze pred nakupom: " .. peniaze)

task.wait(2)

peniaze = 35
print("Peniaze po nakupe: " .. peniaze)]]></ProtectedString>
				<bool name="Disabled">true</bool>
			</Properties>
		</Item>
		<Item class="Part" referent="RBX7">
			<Properties>
				<string name="Name">object_9.4</string>
				<bool name="Anchored">false</bool>
				<Color3uint8 name="Color3uint8">4294298928</Color3uint8>
				<CoordinateFrame name="CFrame"><X>-42.0</X><Y>2.5</Y><Z>-22.0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame>
				<Vector3 name="size"><X>4.0</X><Y>4.0</Y><Z>4.0</Z></Vector3>
				<token name="shape">0</token>
			</Properties>
			<Item class="Script" referent="RBX8">
				<Properties>
					<string name="Name">script_9.4</string>
					<ProtectedString name="Source"><![CDATA[local gula = script.Parent
local sprava = "Nikto so mnou nepohne!"

task.wait(3)
gula.Color = Color3.fromRGB(255, 0, 255)

task.wait(3)
gula.Anchored = true
print(sprava)

task.wait(3)
gula.Anchored = false]]></ProtectedString>
					<bool name="Disabled">true</bool>
				</Properties>
			</Item>
		</Item>
		<Item class="Script" referent="RBX9">
			<Properties>
				<string name="Name">script_9.5</string>
				<ProtectedString name="Source"><![CDATA[local dnes = os.date("%d.%m.%Y")

print("Dnes je " .. dnes)]]></ProtectedString>
