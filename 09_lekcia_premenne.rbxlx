		</Item>
		<Item class="Script" referent="RBX10">
			<Properties>
				<string name="Name">script_9.6</string>
				<ProtectedString name="Source"><![CDATA[local pocet = 0

pocet += 1
print(pocet)
task.wait(0.5)

pocet += 1
print(pocet)
task.wait(0.5)

pocet += 1
print(pocet)
task.wait(0.5)

pocet += 1
print(pocet)
task.wait(0.5)

pocet += 1
print(pocet)]]></ProtectedString>
