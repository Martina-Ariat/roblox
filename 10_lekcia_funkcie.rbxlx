		<Item class="Script" referent="RBX11">
			<Properties>
				<string name="Name">script_10.5</string>
				<ProtectedString name="Source"><![CDATA[local function scitaj(a, b)
    return a + b
end

local function odcitaj(a, b)
    return a - b
end

local function vynasob(a, b)
    return a * b
end

local function vydel(a, b)
    return a / b
end

print("Sucet:  " .. scitaj(10, 5))
print("Rozdiel: " .. odcitaj(10, 5))
print("Sucin:  " .. vynasob(10, 5))
print("Podiel: " .. vydel(10, 5))]]></ProtectedString>
